{$PUBLIC_DOMAIN} {
	# On cible le nom de conteneur exact (la_cave_du_coin-app-1), pas l'alias
	# de service "app" : Docker enregistre automatiquement le nom du service
	# comme alias sur CHAQUE reseau qu'il rejoint, y compris caddy-net - ou le
	# service "app" de staging (alias "stagingapp") repond donc AUSSI a "app".
	# Caddy etant sur les deux reseaux (celui de prod + caddy-net), "app"
	# devenait ambigu et resolvait vers staging au lieu de prod.
	reverse_proxy la_cave_du_coin-app-1:8000
}

# Environnement de test ISO prod (staging) : voir DEPLOYMENT.md.
# N'a d'effet que si PGADMIN_DOMAIN est renseigné dans le .env de prod.
{$PGADMIN_DOMAIN} {
	reverse_proxy pgadmin:80
}

# Application de staging elle-même (pas juste sa base) : voir DEPLOYMENT.md.
# N'a d'effet que si STAGING_DOMAIN est renseigné dans le .env de prod.
{$STAGING_DOMAIN} {
	reverse_proxy stagingapp:8000
}
