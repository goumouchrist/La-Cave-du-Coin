DATABASE_URL=sqlite:///./cave_du_coin.db
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
CASH_GAP_ALERT_THRESHOLD_GNF=10000
STOCK_ALERT_DEFAULT_CARTONS=5
ROUNDING_STEP_GNF=50
CANCEL_WINDOW_MINUTES=5
MIN_MARGIN_RATIO=0.95
IDENTICAL_ITEMS_CONFIRM_THRESHOLD=5
DOUBLE_SCAN_WINDOW_SECONDS=2
STORE_NAME=La Cave du Coin
STORE_ADDRESS=Conakry, Guinée
STORE_NIF=NIF-000000000

BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
# Dossier synchronisé OneDrive/Google Drive pour copier les sauvegardes hors du PC.
# Laisser vide pour désactiver. Exemple :
# OFFSITE_BACKUP_DIR=C:\Users\VotreNom\OneDrive\SauvegardesCaisse
OFFSITE_BACKUP_DIR=

# --- Déploiement Docker (cf. DEPLOYMENT.md) ---
POSTGRES_PASSWORD=change-me

# Choisir UNE des deux lignes COMPOSE_FILE ci-dessous selon le mode de
# déploiement (jamais les deux à la fois) :
#   - VPS distant (admin + boutique à des endroits différents, HTTPS auto) :
# COMPOSE_FILE=docker-compose.yml:docker-compose.vps.yml
#   - PC de la boutique en réseau local (pas de HTTPS nécessaire) :
# COMPOSE_FILE=docker-compose.yml:docker-compose.lan.yml

# Uniquement pour le mode VPS : sans nom de domaine, utiliser l'astuce
# sslip.io (remplacer les points de l'IP du VPS par des tirets), ex. IP
# 178.63.45.12 -> PUBLIC_DOMAIN=178-63-45-12.sslip.io (Caddy obtient alors un
# vrai certificat HTTPS Let's Encrypt automatiquement pour ce nom).
PUBLIC_DOMAIN=change-me.sslip.io
