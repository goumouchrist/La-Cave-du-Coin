# Environnement de test ISO prod (staging) — voir DEPLOYMENT.md.
# Copier ce fichier en ".env.staging" sur le VPS puis renseigner des valeurs.
#
# Astuce : la console web Hetzner déforme les caractères nécessitant Shift
# (: " $ ( ) _ @ ...) à la frappe. Choisissez ici des valeurs UNIQUEMENT
# alphanumériques pour pouvoir les taper sans problème dans ce cas.

POSTGRES_PASSWORD=ChangeMeStaging123

# Généré différemment de celui de prod (les jetons de connexion d'un
# environnement ne doivent pas être valides sur l'autre) :
# python3 -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=ChangeMeStagingJwtSecret123
